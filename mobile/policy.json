{
  "version": 1,
  "killSwitch": false,
  "forbidden": [
    {
      "name": "disable_defense",
      "regex": "(stop|kill|disable|uninstall|mask)\\s+.*(sentinel|guardrail|antivirus|firewall|auditd|ufw|iptables|selinux|apparmor)"
    },
    {
      "name": "self_modify",
      "regex": "(edit|write|modify|patch|replace).*(agent_guardrails|guardrail\\.py|sentinel/|own\\s+(code|weights|prompt))"
    },
    {
      "name": "destroy_data",
      "regex": "rm\\s+-rf\\s+/|mkfs\\.|dd\\s+if=.*of=/dev|shred\\s|format\\s+[a-z]:|drop\\s+(database|table)\\s+(?!temp)"
    },
    {
      "name": "exfiltrate",
      "regex": "(curl|wget|scp|rsync|nc)\\s+.*(\\.env|id_rsa|shadow|credentials|token|\\.pem)"
    },
    {
      "name": "download_exec",
      "regex": "(curl|wget)[^|]*\\|\\s*(ba)?sh"
    },
    {
      "name": "reverse_shell",
      "regex": "nc\\s+.*-e\\s|/dev/tcp/|mkfifo"
    },
    {
      "name": "privesc",
      "regex": "sudo\\s+su|pkexec|chmod\\s+[ug]\\+s"
    },
    {
      "name": "credential_access",
      "regex": "/etc/shadow|/etc/sudoers|authorized_keys|\\.aws/credentials|\\.kube/config"
    },
    {
      "name": "spawn_unbounded",
      "regex": "(spawn|fork|replicate|copy).*(itself|self|agents?\\s+x?\\d{2,})"
    },
    {
      "name": "control_hardware",
      "regex": "(flash|overwrite|write).*(firmware|bios|uefi|bootloader|eeprom)"
    },
    {
      "name": "disable_logging",
      "regex": "(rm|truncate|clear|disable).*(audit|syslog|journal|/var/log)"
    },
    {
      "name": "cloud_metadata",
      "regex": "169\\.254\\.169\\.254|metadata\\.google\\.internal|/latest/meta-data"
    },
    {
      "name": "env_dump",
      "regex": "/proc/self/environ|\\bprintenv\\b|os\\.environ|Get-ChildItem\\s+env:|\\$ENV:|\\benv\\b\\s*(\\||>)"
    },
    {
      "name": "ai_key_exfil",
      "regex": "(curl|wget|scp|rsync|nc|Invoke-WebRequest|irm|iwr)\\s+.*(sk-ant-|sk-[A-Za-z0-9]{32}|AKIA[0-9A-Z]{16}|ghp_|xox[baprs]-|api[_-]?key)"
    },
    {
      "name": "disable_updates",
      "regex": "(stop|disable|mask|config).*(wuauserv|unattended-upgrades|softwareupdate|Set-MpPreference)"
    },
    {
      "name": "register_device",
      "regex": "(register|enroll|join).*(device|tenant).*(actor|attacker|our|my)|deviceRegistration|/devicemanagement/"
    },
    {
      "name": "webshell",
      "regex": "(mu-plugins|wp-content/uploads).*\\.(php|phtml)|\\.(woff2?|ttf|css)\\.php"
    },
    {
      "name": "ws_destroy",
      "regex": "r[\\s\\u00a0\"'`]*m[\\s\\u00a0]*-[\\s\\u00a0]*rf|of[\\s\\u00a0]*=[\\s\\u00a0]*/dev/"
    },
    {
      "name": "ws_disable_defense",
      "regex": "s[\\s\\u00a0\"'`]*t[\\s\\u00a0\"'`]*o[\\s\\u00a0\"'`]*p[\\s\\u00a0]+\\w*def"
    },
    {
      "name": "ws_ransomware",
      "regex": "d[\\s\\u00a0\"'`]*e[\\s\\u00a0\"'`]*l[\\s\\u00a0\"'`]*e[\\s\\u00a0\"'`]*t[\\s\\u00a0\"'`]*e[\\s\\u00a0]+shadow"
    },
    {
      "name": "win_firewall_off",
      "regex": "netsh\\s+advfirewall\\s+set\\s+\\w+\\s+state\\s+off|netsh\\s+firewall\\s+set\\s+opmode\\s+disable"
    },
    {
      "name": "defender_off",
      "regex": "set[\\s-]+mppreference\\s+.*(disablerealtimemonitoring|disableioavprotection|disablebehaviormonitoring)|mpcmdrun\\s+.*-removedefinitions|add[\\s-]+mppreference\\s+.*exclusionpath"
    },
    {
      "name": "backup_destroy",
      "regex": "wbadmin\\s+delete|bcdedit\\s+.*(recoveryenabled\\s+no|bootstatuspolicy)|vssadmin\\s+.*delete|wmic\\s+shadowcopy\\s+delete"
    },
    {
      "name": "sam_dump",
      "regex": "reg\\s+save\\s+.*hklm[\\\\/]+(sam|system|security)|reg\\s+export\\s+.*sam|\\bntdsutil\\b|\\bsecretsdump\\b|\\bmimikatz\\b"
    },
    {
      "name": "ps_encoded",
      "regex": "powershell.*(-e(nc|ncodedcommand)?\\s|-enc\\b|frombase64string|-nop\\s+-w\\s+hidden|-windowstyle\\s+hidden.*-enc)"
    },
    {
      "name": "firmware_flash",
      "regex": "\\bflashrom\\b|\\bfwupd\\b.*--force|dd\\s+.*of=/dev/(sd|nvme|mtd)|\\besptool\\b.*write_flash"
    },
    {
      "name": "clear_event_log",
      "regex": "wevtutil\\s+cl|Clear-EventLog|auditpol\\s+.*/clear|Remove-EventLog"
    },
    {
      "name": "lolbin_exec",
      "regex": "\\b(certutil|bitsadmin|mshta|regsvr32|rundll32)\\b.*(http|-urlcache|javascript:|scrobj|/i:)|\\bwmic\\b.*process\\s+call\\s+create"
    },
    {
      "name": "chained_exec",
      "regex": "(&&|;|\\|\\|)\\s*(/tmp/|/dev/shm/|/var/tmp/|\\./)|chmod\\s+\\+x\\s+/tmp/.*(&&|;)|\\b(sh|bash|zsh)\\s+/tmp/|(>|>>)\\s*/tmp/\\S+\\s*(&&|;)\\s*(sh|bash)"
    },
    {
      "name": "temp_exec_chain",
      "regex": "(curl|wget)\\s+.*(>|-o|-O)\\s*/tmp/.*(&&|;|\\|\\|)\\s*(sh|bash|/tmp/)|(curl|wget)[^|]*\\|\\s*(ba|z)?sh"
    },
    {
      "name": "interp_exec",
      "regex": "(python[0-9.]*|perl|ruby|node|php)\\s+-[ceEm].*(os\\.system|system\\(|child_process|exec\\(|popen|import\\s+os|__import__)|awk\\s+.*system\\("
    },
    {
      "name": "path_hijack",
      "regex": "export\\s+PATH=/tmp|PATH=(/tmp|/dev/shm|\\.):|LD_LIBRARY_PATH=/tmp"
    },
    {
      "name": "lib_inject",
      "regex": "\\bLD_PRELOAD=|\\bDYLD_INSERT_LIBRARIES="
    },
    {
      "name": "cron_persist",
      "regex": "crontab\\s+-|/var/spool/cron|/etc/cron|\\bat\\s+(now|midnight|[0-9])|systemd-run|systemctl\\s+enable|launchctl\\s+(load|submit|bootstrap)"
    },
    {
      "name": "rc_persist",
      "regex": ">>?\\s*~?/?\\.?(bashrc|zshrc|bash_profile|profile|zprofile)|>>?\\s*/etc/rc\\.local"
    },
    {
      "name": "decode_exec",
      "regex": "base64\\s+-d.*\\|\\s*(sh|bash)|\\|\\s*base64\\s+-d\\s*\\|\\s*(sh|bash)|xxd\\s+-r\\s+-p\\s*\\|\\s*(sh|bash)|tr\\s+[^|]*\\|\\s*(sh|bash)|\\$'\\\\x[0-9a-f]|\\$'\\\\[0-7]{3}|\\$'\\\\x[0-9a-f]{2}|\\$'\\\\[0-7]{2,3}|\\$'\\\\x[0-9a-f]|\\$'\\\\[0-7]"
    },
    {
      "name": "fileless_mem",
      "regex": "/proc/self/mem|memfd_create|>\\s*/proc/[0-9]+/mem"
    },
    {
      "name": "privesc_vectors",
      "regex": ">>?\\s*/etc/sudoers|chmod\\s+4[0-7][0-7][0-7]|setcap\\s+cap_|\\bpkexec\\b|nsenter\\s+-t\\s+1|--privileged.*chroot|mount\\s+/dev/sd.*chroot"
    },
    {
      "name": "cred_theft",
      "regex": "\\.ssh/id_(rsa|ed25519|ecdsa|dsa)|\\.aws/(credentials|config)|\\.kube/config|\\.config/gcloud|dump-keychain|login\\s*data|\\.(bash|zsh)_history|/run/secrets/|chrome/(default|profile).*(login\\s*data|cookies)|/library/application support/(google|firefox)|application support/google|/chrome/.*(default|login)|cp\\s+.*chrome"
    },
    {
      "name": "exfil_channels",
      "regex": "nslookup\\s+\\$\\(|dig\\s+\\$\\(|ping\\s+-p\\s+\\$\\(|curl.*-d\\s+@/(etc|home|root)|aws\\s+s3\\s+cp\\s+/(etc|home|root)|-F\\s+.?c?=?@/(etc|shadow)"
    },
    {
      "name": "imds_access",
      "regex": "169\\.254\\.169\\.254|metadata\\.google\\.internal|metadata-flavor:\\s*google|metadata:true"
    },
    {
      "name": "defense_evasion",
      "regex": "unset\\s+histfile|histsize=0|set\\s+\\+o\\s+history|touch\\s+-[rt]\\s|auditctl\\s+-e\\s+0|setenforce\\s+0|aa-disable|systemctl\\s+stop\\s+(auditd|apparmor|rsyslog)|iptables\\s+-f\\b|nft\\s+flush|service\\s+rsyslog\\s+stop|iptables\\s+-p\\s+\\w+\\s+accept|selinux=disabled|>\\s*/etc/selinux"
    },
    {
      "name": "destruction2",
      "regex": ":\\(\\)\\s*\\{\\s*:\\|:&\\s*\\}|find\\s+/.*-delete|find\\s+/.*-exec\\s+(openssl|gpg|rm)|gpg\\s+--encrypt-files|shred\\s+-u|rm\\s+-rf\\s+/(backup|snapshots)|while\\s+true.*do.*(sh|bash)\\s*&|cat\\s+/dev/(zero|urandom)\\s*>\\s*/dev/(sd|disk|nvme)|>\\s*/dev/(sd[a-z]|disk[0-9])"
    },
    {
      "name": "container_secrets",
      "regex": "kubectl\\s+get\\s+secrets|kubectl\\s+exec.*secrets|--unix-socket\\s+/var/run/docker\\.sock"
    },
    {
      "name": "supply_chain",
      "regex": "pip\\s+install\\s+.*(--index-url\\s+http://|/tmp/|http://)|npm\\s+install\\s+(http://|https://|/tmp/|git\\+http|\\S+\\.tgz)|(curl|wget)\\s+\\S+\\s*\\|\\s*sudo\\s+(ba)?sh|\\.git/hooks/"
    },
    {
      "name": "win_persist2",
      "regex": "schtasks\\s+/create|sc\\s+create\\s+\\w+\\s+binpath|wmic\\s+.*__eventfilter|reg\\s+add\\s+.*\\\\(run|winlogon|image\\s+file\\s+execution)"
    },
    {
      "name": "win_uac_disable",
      "regex": "enablelua\\s+/t\\s+reg_dword\\s+/d\\s+0|reg\\s+add.*enablelua.*\\s0"
    },
    {
      "name": "win_lsass",
      "regex": "procdump\\s+.*lsass|comsvcs\\.dll\\s+minidump|rundll32.*comsvcs.*minidump"
    },
    {
      "name": "win_lolbin2",
      "regex": "\\bmshta\\s+(http|vbscript:|javascript:)|regsvr32\\s+.*(/i:http|scrobj)|bitsadmin\\s+.*/transfer"
    },
    {
      "name": "gpu_fw_flash",
      "regex": "\\bnvflash\\b|\\bafulnx?[0-9]*\\b|\\bamdvbflash\\b"
    },
    {
      "name": "log_wipe_extra",
      "regex": "(cat\\s+/dev/null|:|truncate\\s+-s\\s*0|>\\s*)\\s*>?\\s*/var/log/|echo\\s+-n\\s*>\\s*/var/log"
    },
    {
      "name": "self_exfil",
      "regex": "(cp|scp|curl|rsync)\\s+.*(\\.gguf|\\.safetensors|/models/|weights|\\.ckpt|\\.pt\\b).*(/tmp|curl|scp|@)"
    },
    {
      "name": "win_run_key",
      "regex": "reg\\s+add\\s+.*(currentversion.{0,3}run|\\\\run\\b)"
    },
    {
      "name": "relative_temp_exec",
      "regex": "^\\s*\\./|/\\.\\./.*/(tmp|shm)/|\\bsh\\s+\\./"
    },
    {
      "name": "agent_replicate",
      "regex": "spawn\\s+\\d{2,}|replicate\\s+(self|to)|fork\\s+\\d{3,}|clone\\s+(self|agent)"
    },
    {
      "name": "npm_remote",
      "regex": "npm\\s+install\\s+(http://|https://|/tmp/|git\\+http|\\S+\\.tgz)"
    }
  ],
  "defaults": {
    "capabilities": [
      "^read:.*$",
      "^search:.*$",
      "^summarize:.*$"
    ],
    "denyTargets": [
      "^/etc/.*$",
      "^/boot/.*$",
      "^/root/.*$",
      "^.*/\\.ssh/.*$",
      "^.*/\\.env$",
      "^.*/policy/agent_guardrails\\.yaml$",
      "^.*/sentinel/.*$"
    ],
    "allowTargets": [],
    "requireApproval": [
      "^delete:.*$",
      "^deploy:.*$",
      "^send:.*$",
      "^pay:.*$",
      "^shell:.*$",
      "^spawn:.*$",
      "^register:.*$"
    ],
    "rateLimit": {
      "max": 60,
      "window_s": 60
    },
    "budget": 100.0
  },
  "agents": [
    {
      "match": "^os\\-activity$",
      "config": {
        "capabilities": [
          "^exec$",
          "^net:connect$",
          "^read:.*$"
        ],
        "denyTargets": [
          "^.*id_rsa.*$",
          "^.*/shadow$",
          "^.*/etc/sudoers.*$"
        ],
        "allowTargets": [],
        "requireApproval": [
          "^delete:.*$",
          "^deploy:.*$",
          "^send:.*$",
          "^pay:.*$",
          "^shell:.*$",
          "^spawn:.*$",
          "^register:.*$"
        ],
        "rateLimit": {
          "max": 100000,
          "window_s": 60
        },
        "budget": 1000000.0
      }
    },
    {
      "match": "^coder\\-.*$",
      "config": {
        "capabilities": [
          "^read:.*$",
          "^write:file$",
          "^run:test$",
          "^run:lint$",
          "^shell:.*$"
        ],
        "denyTargets": [
          "^/etc/.*$",
          "^/boot/.*$",
          "^/root/.*$",
          "^.*/\\.ssh/.*$",
          "^.*/\\.env$",
          "^.*/policy/agent_guardrails\\.yaml$",
          "^.*/sentinel/.*$"
        ],
        "allowTargets": [
          "^/workspace/.*$",
          "^/tmp/.*$"
        ],
        "requireApproval": [
          "^shell:.*$",
          "^delete:.*$",
          "^write:.*\\.yaml$",
          "^write:.*\\.yml$"
        ],
        "rateLimit": {
          "max": 120,
          "window_s": 60
        },
        "budget": 500.0
      }
    },
    {
      "match": "^ops\\-.*$",
      "config": {
        "capabilities": [
          "^read:.*$",
          "^restart:service$",
          "^scale:.*$",
          "^deploy:.*$"
        ],
        "denyTargets": [
          "^/etc/.*$",
          "^/boot/.*$",
          "^/root/.*$",
          "^.*/\\.ssh/.*$",
          "^.*/\\.env$",
          "^.*/policy/agent_guardrails\\.yaml$",
          "^.*/sentinel/.*$"
        ],
        "allowTargets": [],
        "requireApproval": [
          "^deploy:prod.*$",
          "^scale:.*$"
        ],
        "rateLimit": {
          "max": 60,
          "window_s": 60
        },
        "budget": 50.0
      }
    },
    {
      "match": "^untrusted\\-.*$",
      "config": {
        "capabilities": [
          "^read:public/.*$"
        ],
        "denyTargets": [
          "^/etc/.*$",
          "^/boot/.*$",
          "^/root/.*$",
          "^.*/\\.ssh/.*$",
          "^.*/\\.env$",
          "^.*/policy/agent_guardrails\\.yaml$",
          "^.*/sentinel/.*$"
        ],
        "allowTargets": [],
        "requireApproval": [
          "^delete:.*$",
          "^deploy:.*$",
          "^send:.*$",
          "^pay:.*$",
          "^shell:.*$",
          "^spawn:.*$",
          "^register:.*$"
        ],
        "rateLimit": {
          "max": 10,
          "window_s": 60
        },
        "budget": 5.0
      }
    }
  ]
}